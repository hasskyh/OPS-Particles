#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = C:\MSYS2\mingw64\bin\cmake.exe --regenerate-during-build -SC:\Users\44793\VScode\OPS -BC:\Users\44793\VScode\OPS\build
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = C:\MSYS2\mingw64\bin\ninja.exe $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = C:\MSYS2\mingw64\bin\ninja.exe -t targets
  description = All primary targets available:

